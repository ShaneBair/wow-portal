{
  "name": "wow-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite --config vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "tsc -p client/tsconfig.json && vite build --config vite.config.ts",
    "test": "npm run test:server && npm run test:client",
    "test:server": "tsc -p tsconfig.test.json && node --test dist-test/tests/azerothcore.test.js dist-test/tests/online-roster.test.js dist-test/tests/online-players-route.test.js dist-test/tests/client-routing.test.js",
    "test:client": "vitest run --config vite.config.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "fast-xml-parser": "^5.11.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.5",
    "jsdom": "30.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
