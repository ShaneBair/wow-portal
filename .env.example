PORT=8090
SITE_NAME=Epic Server
WOW_REALMLIST=wow.domain.com

# Friends-only registration protection.
INVITE_CODE=change-me

# AzerothCore SOAP endpoint over the shared Docker network.
ACORE_SOAP_URL=http://ac-worldserver:7878/
ACORE_SOAP_USER=PORTAL_SERVICE
ACORE_SOAP_PASSWORD=change-me

# Read-only MariaDB connection for historical statistics. Use a dedicated user
# with SELECT access only to mod_player_stats_events, mod_player_stats_migrations,
# characters, and the auth account table.
STATS_DB_HOST=mariadb.internal
STATS_DB_PORT=3306
STATS_DB_USER=portal_stats_reader
STATS_DB_PASSWORD=change-me
STATS_CHARACTERS_DATABASE=characters_database
STATS_AUTH_DATABASE=auth_database

# Least-privilege game database connection for portal authentication and boosts.
PORTAL_DB_HOST=ac-database
PORTAL_DB_PORT=3306
PORTAL_DB_USER=wow_portal_app
PORTAL_DB_PASSWORD=change-me
PORTAL_AUTH_DATABASE=acore_auth
PORTAL_CHARACTERS_DATABASE=acore_characters
PORTAL_STATE_DATABASE=wow_portal

# Exact browser origin allowed to submit credentials and authenticated mutations.
# Production must use HTTPS. For local Vite development, use http://localhost:5173
# and open that exact origin in the browser.
PORTAL_PUBLIC_ORIGIN=https://play.domain.com

# Free Money remains disabled until the portal-state migration, least-privilege
# grants, deployed-core command fixtures, and operator checks are complete.
BOOST_MONEY_ENABLED=false
BOOST_MONEY_MAX_GOLD_PER_REQUEST=10000
BOOST_MONEY_DAILY_GOLD_LIMIT=20000
BOOST_MONEY_DAILY_REQUEST_LIMIT=5

# Hole Lotta Storage remains disabled until its migration, grants, exact deployed-core
# send-items fixture, item-template facts, and operator delivery checks are complete.
BOOST_PORTABLE_HOLES_ENABLED=false
